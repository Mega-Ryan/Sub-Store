{
  "name": "sub-store-cloudflare-basic",
  "private": true,
  "type": "module",
  "version": "2.42.2-cf.1",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:conversion": "node test-conversion.mjs",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.staging.jsonc",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --config wrangler.staging.jsonc",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "ip-address": "10.3.1",
    "js-base64": "3.7.8",
    "json5": "2.2.3",
    "lodash": "4.17.21",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "peggy": "2.0.1",
    "esbuild": "0.28.1",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  }
}
